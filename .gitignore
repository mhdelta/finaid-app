# Datos personales — NUNCA se versionan por defecto.
# Si tu fork es PRIVADO y quieres versionar tu instancia, edita esto a conciencia.
finanzas_base.md
datos/*
!datos/backup/
datos/backup/*
extractos/entrada/*
extractos/procesados/*
revisiones/*
# piloto/bitacora.md NO se ignora a propósito: se escribe sin datos personales
# (ver plantillas/bitacora.template.md) y es el canal de retorno hacia el marco.

# conservar la estructura de carpetas vacía
!**/.gitkeep

# sello de version que escribe el instalador en cada instancia
.marco-version

# temporales
*.pyc
__pycache__/
.ipynb_checkpoints/
